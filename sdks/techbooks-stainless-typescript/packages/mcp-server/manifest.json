{
  "dxt_version": "0.1",
  "name": "techbooks-stainless-mcp",
  "version": "0.0.1",
  "description": "The official MCP Server for the Techbooks Stainless API",
  "author": {
    "name": "Techbooks Stainless",
    "email": "john@example.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stainless-sdks/techbooks-stainless-typescript.git"
  },
  "homepage": "https://github.com/stainless-sdks/techbooks-stainless-typescript/tree/main/packages/mcp-server#readme",
  "documentation": "https://example.com",
  "server": {
    "type": "node",
    "entry_point": "${__dirname}/index.js",
    "mcp_config": {
      "command": "node",
      "args": ["${__dirname}/index.js"],
      "env": {
        "TECHBOOKS_STAINLESS_API_KEY": "${user_config.TECHBOOKS_STAINLESS_API_KEY}"
      }
    }
  },
  "user_config": {
    "TECHBOOKS_STAINLESS_API_KEY": {
      "title": "api_key",
      "description": "",
      "required": true,
      "type": "string"
    }
  },
  "tools_generated": true,
  "compatibility": {
    "runtimes": {
      "node": ">=18.0.0"
    }
  },
  "keywords": ["api"]
}
